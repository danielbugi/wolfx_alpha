# mechanism/Dockerfile.stage2 -- the Stage 2 image: the production-pinned mechanism image PLUS ONLY the reviewed quarterly-fundamentals
# correction and (since 2026-10-23) the reviewed channel earnings-post correction (PR #55).
#
# Why a derived image and not a rebuild of mechanism/Dockerfile: that Dockerfile builds FROM the floating tag python:3.11-slim, runs apt-get install and installs requirements, 5 of which are
# unpinned ranges (aiogram>=3.13,<4, pillow>=10.1, matplotlib>=3.8, mplfinance, ...). A rebuild today could therefore change the base layers' packages and third-party libraries (for example the
# Telegram bot library the notices use) even though only one source file changed. Starting FROM the pinned image's immutable digest makes the image diff exactly the files copied below.
#
# Base: ghcr.io/danielbugi/wolfx_alpha-mechanism:5c511899505a  (the image CURRENT_MECHANISM_SHA points at since 2026-10-10).
FROM ghcr.io/danielbugi/wolfx_alpha-mechanism@sha256:be0ec3ce31176dcb1b7ee7713765705b64d0b10e79b05ce784721b41b0cc1760

COPY --chmod=755 automation_pipeline.sh /app/automation_pipeline.sh
COPY mechanism/data_updaters/quarterly_fundamentals_updater.py /app/mechanism/data_updaters/quarterly_fundamentals_updater.py
COPY mechanism/data_updaters/tests/test_quarterly_budget.py /app/mechanism/data_updaters/tests/test_quarterly_budget.py
COPY mechanism/forward_collection/tests/test_quarterly_ordering_db.py /app/mechanism/forward_collection/tests/test_quarterly_ordering_db.py
# Channel earnings correctness (PR #55, owner-approved 2026-10-23): the 'reports today' post reads only CURRENT earnings_calendar rows.
# At the pinned commit 5c51189 send_earnings_today.py differs from main ONLY by PR #55; the other two modules are new and imported only
# by it. Nothing here is imported by the screener, ledger writer, evaluator, collector or paper tracker.
COPY mechanism/alerts/send_earnings_today.py /app/mechanism/alerts/send_earnings_today.py
COPY mechanism/alerts/earnings_current.py /app/mechanism/alerts/earnings_current.py
COPY mechanism/alerts/earnings_today_query.py /app/mechanism/alerts/earnings_today_query.py
COPY mechanism/alerts/tests/test_earnings_today_current.py /app/mechanism/alerts/tests/test_earnings_today_current.py
# Channel rebrand "First Light ⚡ Market Daily" (owner decisions 2026-10-21..25, PR #49): the ONE daily public market brief replaces the
# separate post-market posts (POST_MARKET_FORMAT=report, default; =package restores the old four), the other recurring posts are paused by
# default (channel_switches.py), plus the brand artwork, the assistant posts' pictures and the channel branding script. At the pinned commit
# 5c51189 every MODIFIED file below is byte-identical to its pre-change version on main (verified 2026-10-25), so the delta is exactly the
# reviewed change. send_earnings_today.py (above) is PR #55's version plus the pause switch. None of these is imported by the screener, the
# ledger writer, the evaluator, the collector or the paper tracker.
COPY mechanism/alerts/channel_switches.py /app/mechanism/alerts/channel_switches.py
COPY mechanism/alerts/market_report.py /app/mechanism/alerts/market_report.py
COPY mechanism/alerts/brand_assets.py /app/mechanism/alerts/brand_assets.py
COPY mechanism/alerts/channel_branding.py /app/mechanism/alerts/channel_branding.py
COPY mechanism/alerts/market_card.py /app/mechanism/alerts/market_card.py
COPY mechanism/alerts/channel_content.py /app/mechanism/alerts/channel_content.py
COPY mechanism/alerts/channel_posts.py /app/mechanism/alerts/channel_posts.py
COPY mechanism/alerts/publish_post_market.py /app/mechanism/alerts/publish_post_market.py
COPY mechanism/alerts/send_channel_notices.py /app/mechanism/alerts/send_channel_notices.py
COPY mechanism/alerts/send_channel_posts.py /app/mechanism/alerts/send_channel_posts.py
COPY mechanism/alerts/send_daily_digest.py /app/mechanism/alerts/send_daily_digest.py
COPY mechanism/alerts/tests/test_market_report.py /app/mechanism/alerts/tests/test_market_report.py
COPY mechanism/alerts/tests/test_notices.py /app/mechanism/alerts/tests/test_notices.py
# Earnings freshness (PR #75, 2026-10-31 engineering directive): the calendar updater re-asks a symbol every run while a report date within the last 7 days has no reported EPS.
# At the pinned commit 5c51189 earnings_calendar_updater.py is byte-identical to main before PR #75 (verified 2026-10-31), so the delta is exactly that change. Used only by pipeline step 7.
COPY mechanism/data_updaters/earnings_calendar_updater.py /app/mechanism/data_updaters/earnings_calendar_updater.py
COPY mechanism/data_updaters/tests/test_earnings_calendar_updater.py /app/mechanism/data_updaters/tests/test_earnings_calendar_updater.py
