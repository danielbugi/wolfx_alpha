# docker/.env.example — placeholder configuration for the LOCAL DOCKER COMPOSE VALIDATION
# STACK ONLY. Every value here is a dummy/dev-only default, deliberately distinct from the
# real repo-root `.env` used for host-based local dev (docs/devops/CURRENT_ARCHITECTURE.md §6).
#
# Why a separate file instead of reusing the real `.env`: backend/main.py calls
# load_dotenv(path, override=True) against a `.env` it expects one level above `backend/`; if a
# real `.env` were ever mounted into a container at that path, its on-disk values would silently
# win over whatever Compose injected (this exact class of bug already happened twice in this
# project outside Docker — see CLAUDE.md's 2026-09-22 changelog entries). The containers in
# docker-compose.yml never mount any `.env` file at all — only Compose's own `env_file:` +
# `environment:` injection is used, which both load_dotenv() (main.py) and
# mechanism/shared/config.py's load_env_file() gracefully no-op around when no on-disk file is
# found, leaving the Compose-injected values as the only ones the app ever sees.
#
# To run the validation stack: `docker compose --env-file docker/.env.example up -d` (or copy this
# file to `docker/.env.local`, edit as needed, and point --env-file there — never commit real
# secrets into a copy of this file). This file only backs the BASE docker-compose.yml; anything
# read only by the docker-compose.prod.yml overlay (API_SITE_ADDRESS, IMAGE_TAG) is out of scope
# for it and intentionally not declared below — see the note at the bottom.
#
# PROD_SENDING_ENABLED must stay 0 for any local validation run — this is the one gate that
# controls whether the Telegram bot/senders are allowed to post to the real public channel
# (mechanism/alerts/telegram_client.py's PROD_SWITCH; docs/devops/CURRENT_ARCHITECTURE.md §6,
# "Production lock"). The bot token below is an intentionally invalid placeholder for the same
# reason: even if the `bot`/`channel-sender` services are started against this file, they cannot
# authenticate as the real bot.
#
# Classification used below (per the 2026-09-25 repository consolidation audit, Phase 1 item 4):
#   [secret]    a real credential — never fill this in here, only in the real, untracked `.env`.
#   [required]  non-secret but load-bearing — the app behaves differently, often unsafely, if unset.
#   [optional]  has a safe in-code fallback; listed for visibility/tunability only.
#   [dev-only]  meaningful only for local/build tooling, never read by a running container.
# A value with no tag inline is [optional] by default within its section.

# --- Database (matches the postgres service's own POSTGRES_* values in docker-compose.yml) ---
# DB_USER MUST be `trading_user` — mechanism/create_trading_schema.sql (existing, unmodified) ends
# with `GRANT ... TO trading_user`, assuming that role already exists (matching
# mechanism/shared/config.py's own default DB_USER fallback). Postgres's official image aborts its
# ENTIRE docker-entrypoint-initdb.d sequence on the first script error, so a mismatched role name
# here doesn't just fail one GRANT — it silently skips every SQL file after the one that errors.
# Found and fixed during Phase 2 local validation; see docs/devops/ for the full write-up.
DB_HOST=postgres                              # [required]
DB_PORT=5432                                  # [required]
DB_NAME=donchian_docker_dev                   # [required]
DB_USER=trading_user                          # [required]
DB_PASSWORD=docker_local_dev_only_change_me   # [secret] (a throwaway value for this local stack only)

# --- Database connection pooling — two independent pools, two independent variable-name
# conventions, by two different subsystems connecting to the SAME Postgres instance
# (backend/main.py's own psycopg2 ThreadedConnectionPool vs mechanism/shared/config.py's
# DatabaseManager). Tuning one has zero effect on the other — a real, confirmed inconsistency
# flagged as P1-7 in the 2026-09-25 audit, not yet unified pending approval. Both are [optional]:
# each has a safe in-code default and only needs setting to tune pool size / timeouts.
DB_POOL_MIN=8                # backend/main.py — min pooled connections
DB_POOL_MAX=30               # backend/main.py — max pooled connections
DB_POOL_MIN_SIZE=2           # mechanism/shared/config.py — min pooled connections
DB_POOL_MAX_SIZE=10          # mechanism/shared/config.py — max pooled connections
DB_TIMEOUT=60                # mechanism/shared/config.py — seconds

# --- Backend / API ---
API_HOST=0.0.0.0                              # [required]
API_PORT=8000                                 # [required]
ALLOWED_ORIGINS=http://localhost:8080         # [required] — backend/main.py fails closed if this would ever resolve to `*` with credentials enabled
API_TIMEOUT=30                                # mechanism/shared/config.py, seconds
API_RATE_LIMIT=100                            # mechanism/shared/config.py

# --- Auth (backend/auth/) ---
JWT_SECRET=dev-only-insecure-secret-change-before-any-real-deploy   # [secret] — backend fails to start if unset; production has its own real value, never this one
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_CODE_TTL_MINUTES=10
MAX_LOGIN_CODE_ATTEMPTS=5

# --- Email (2FA codes) — left blank on purpose: email_service.py falls back to logging the
# code server-side when SMTP_HOST is unset, which is what you want for local validation.
SMTP_HOST=                                    # [secret] when set — real SMTP credentials only go in the real, untracked .env
SMTP_PORT=587
SMTP_USER=                                    # [secret] when set
SMTP_PASSWORD=                                # [secret] when set
SMTP_FROM=

# --- Data providers — yfinance needs no key at all, so this is the only provider that can be
# exercised safely with zero real credentials (see mechanism/Dockerfile's validation notes).
DATA_PROVIDER=yfinance
ALPACA_API_KEY=                               # [secret] when set
ALPACA_API_SECRET=                            # [secret] when set
TIINGO_API_KEY=                               # [secret] when set

# --- Data update tuning (mechanism/shared/config.py; all [optional], sane hardcoded fallbacks) ---
DATA_BATCH_SIZE=1000
MAX_CONCURRENT_UPDATES=5
RATE_LIMIT_DELAY=1.0

# --- Screener tuning (mechanism/shared/config.py already has sane hardcoded fallbacks for all
# of these; listed here only for visibility — safe to leave as-is for validation) ---
MIN_PRICE=5
MAX_PRICE=1000
MIN_VOLUME=100000
MIN_MARKET_CAP=100000000
MIN_QUALITY_SCORE=50
VOLUME_SPIKE_THRESHOLD=2.0

# --- ML tuning (mechanism/shared/config.py) ---
ML_LOOKFORWARD_DAYS=10        # NOTE: the variable actually read is ML_LOOKFORWARD_DAYS, not a
                               # bare LOOKFORWARD_DAYS — a real name-mismatch this file previously
                               # had (found by the 2026-09-25 audit), silently a no-op if set.
ML_MIN_DATA_POINTS=50

# --- Trading-day / freshness gate (mechanism/shared/market_calendar.py) ---
# [required] in spirit, [optional] in code: MARKET_SETTLE_MINUTES has a safe-looking in-code
# default (120) but production actually runs on 30 — this variable being unset here silently
# changes when the nightly pipeline/post-market publisher considers a session "complete" and
# ready to process. Flagged as a real gap (missing from this file entirely) by the 2026-09-25
# audit; kept at the code default here since local validation has no real trading-day timing to
# match — set it explicitly to 30 if you need this stack to behave like production.
MARKET_SETTLE_MINUTES=120

# --- Logging / paths (mechanism/shared/config.py; all [optional]) ---
LOG_LEVEL=INFO
LOG_FILE_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5
DATA_DIR=data
LOGS_DIR=logs
REPORTS_DIR=reports
FRONTEND_DATA_DIR=frontend_data

# --- Performance monitoring (mechanism/shared/config.py; [optional]) ---
PERFORMANCE_MONITORING=true
METRIC_COLLECTION_INTERVAL=60

# --- Telegram — intentionally invalid placeholders. Do not put a real bot token in this file. ---
TELEGRAM_BOT_TOKEN=000000000:INVALID-PLACEHOLDER-TOKEN-FOR-LOCAL-VALIDATION-ONLY   # [secret]
TELEGRAM_CHAT_ID=                             # [secret] when set (a real channel id)
TELEGRAM_DEV_CHAT_ID=                         # [secret] when set
TELEGRAM_BOT_USERNAME=                        # [optional] — falls back to a live getMe() call when blank
TELEGRAM_CONTROL_TOKEN=dev-only-placeholder-control-token   # [secret] — unset/placeholder means every Telegram Control Center mutation is refused (fails closed, by design)
TELEGRAM_READ_REQUIRES_TOKEN=0                # [optional] — opt-in toggle, off by default; only relevant once the dashboard API is hosted somewhere other than localhost
BOT_OWNER_ID=0                                # [required] for the bot — unset means no new user can ever be approved
PROD_SENDING_ENABLED=0                        # [required] — THE production-posting safety gate (mechanism/alerts/telegram_client.py's PROD_SWITCH). Must stay 0 here.

# --- Bot access / rate limits (mechanism/alerts/run_bot.py, backend/services/bot_access_service.py; all [optional], sane fallbacks) ---
BOT_ACCESS_MODE=approve       # approve | auto | closed
BOT_MAX_MEMBERS=25
BOT_MAX_PENDING=100
BOT_MSG_LIMIT=120             # messages/hour/user
BOT_POPUP_LIMIT=300           # popup taps/hour/user
BOT_GROUP_LIMIT=5             # messages/minute/group
BOT_HEAVY_LIMIT=30            # heavy (news/chart) calls/hour/user
BOT_LOCK_PORT=47831           # localhost port used to refuse a second run_bot.py instance

# --- Channel content feature flags (mechanism/alerts/send_channel_posts.py, channel_control.py; all [optional]) ---
CHANNEL_BOARD_ENABLED=1       # momentum board post — on by default
CHANNEL_NEWS_ENABLED=0        # off by default — news-provider licence terms not yet checked
CHANNEL_SCOREBOARD_ENABLED=0  # off by default — see CLAUDE.md for why (an unflattering first result)

# --- Alerts / digest ---
ALERTS_TIMEZONE=Asia/Jerusalem
ALERTS_TOP_N=15
ALERTS_MAX_NEWS_LINKS=2
ALERTS_PLAN=balanced

# --- Frontend build-time value (read by docker-compose.yml, not by any Python service) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080   # [required] for a production frontend build (frontend/next.config.ts throws without it); a dev build falls back to 127.0.0.1

# --- Intentionally NOT declared above (2026-09-25 audit findings) ---
# - API_SITE_ADDRESS, IMAGE_TAG: read only by docker-compose.prod.yml (the production overlay),
#   never by the base docker-compose.yml this file backs. Declaring them here would suggest this
#   validation stack exercises the production overlay, which it does not.
# - NODE_ENV, NEXT_DIST_DIR: build/tooling-time values (Next.js sets NODE_ENV itself for
#   `next build`/production start; NEXT_DIST_DIR is only for an isolated local verification build
#   run outside Docker — see CLAUDE.md §13). Neither is read inside a running container.
# - POSTGRES_DB, POSTGRES_HOST, POSTGRES_PORT, POSTGRES_USER, POSTGRES_PASSWORD: legacy fallback
#   names, read only by mechanism/diagnostic_tools/check_database_schema.py and an archived
#   ml_training/scripts/backup/ script when the real DB_* vars above are unset — not part of the
#   live app's own configuration path. Use DB_* instead; these are not declared to avoid implying
#   they matter for normal operation.
# - ALERTS_SEND_LOCAL_TIME, DEBUG, DONCHIAN_PERIOD, ENVIRONMENT, FUNDAMENTALS_DELAY, MAX_RETRIES,
#   YAHOO_DELAY, a bare LOOKFORWARD_DAYS: previously listed in this file but confirmed by a
#   repo-wide grep to be read by zero current code (some are historical Flask-era leftovers this
#   project already removed once from the real `.env`, per CLAUDE.md's 2026-09-14 changelog, that
#   had crept back into this newer file; ML_LOOKFORWARD_DAYS above is the real name that replaced
#   the bare LOOKFORWARD_DAYS). Removed rather than kept as dead weight.
