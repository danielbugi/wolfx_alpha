[Unit]
Description=Run the First Light nightly production database backup

[Timer]
# 02:30 Israel time -- after the (not-yet-enabled) 23:45/01:00 VPS pipeline window, matching the
# Windows schedule's own timing logic (CUTOVER_PLAN.md).
OnCalendar=*-*-* 23:30:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
