[Unit]
Description=First Light: run the daily pipeline (23:45 Israel, 01:00 retry -- matches the disabled Windows DonchianScreenerDailyPipeline task; the 01:00 fire is a no-op once the day is already marked done by market_calendar.py)

[Timer]
OnCalendar=*-*-* 23:45:00 Asia/Jerusalem
OnCalendar=*-*-* 01:00:00 Asia/Jerusalem
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
